[Unit]
Description=TG Player API
After=network.target

[Service]
Type=simple
User=ganja
Group=ganja
WorkingDirectory=/opt/tg_player
Environment=PATH=/opt/tg_player/venv/bin
ExecStart=/opt/tg_player/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
