# Telegram Bot
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username  # Without @, for Telegram Login Widget

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tg_player
# For SQLite (development): sqlite+aiosqlite:///./tg_player.db

# API
API_HOST=0.0.0.0
API_PORT=8000
API_URL=https://your-domain.com/api

# Mini App
WEBAPP_URL=https://your-domain.com

# Security
SECRET_KEY=your-secret-key-generate-random-string
JWT_EXPIRE_DAYS=30  # How long browser auth tokens are valid

# last fm
LASTFM_API_KEY=your_lastfm_api_key_here