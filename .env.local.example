# ===========================================
#  TG Player - ЛОКАЛЬНАЯ РАЗРАБОТКА
# ===========================================
# Скопируй этот файл в .env.local и заполни

# Telegram Bot - ТЕСТОВЫЙ! Создай отдельного бота через @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_USERNAME=my_dev_bot

# База данных
# Вариант 1: SQLite (проще, файл создастся сам)
DATABASE_URL=sqlite+aiosqlite:///./tg_player_dev.db

# Вариант 2: PostgreSQL (как на проде, нужен Docker)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tg_player

# API
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# Mini App URL
# Для локальной разработки используй ngrok или просто localhost
WEBAPP_URL=http://localhost:5173

# Security (можно любой для дева)
SECRET_KEY=local-dev-secret-key-12345

# Last.fm (опционально, для обложек)
LASTFM_API_KEY=
